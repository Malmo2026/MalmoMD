<!-- FAQ -->
<section class="faq">
  <div class="container--narrow">
    <h2 class="section__title" style="margin-bottom:2rem;">Frequently asked <span class="gradient-text">questions</span></h2>
    <div class="faq__list">
      <div class="faq__item">
        <button class="faq__trigger" onclick="toggleFaq(this)">
          <span class="faq__q">What is Malmo?</span>
          <span class="faq__icon">▾</span>
        </button>
        <div class="faq__content">
          <p class="faq__a">Malmo offers treatments for weight loss, longevity and women's hormone therapy, connecting customers with compassionate, licensed practitioners through telehealth for personalized care and guidance.</p>
        </div>
      </div>
      <div class="faq__item">
        <button class="faq__trigger" onclick="toggleFaq(this)">
          <span class="faq__q">How does it work?</span>
          <span class="faq__icon">▾</span>
        </button>
        <div class="faq__content">
          <p class="faq__a">At Malmo, we believe in being your comprehensive ally in wellness. Our user-friendly, three-step journey makes starting treatment effortless: (1) Fill out a medical questionnaire. (2) Engage in a chat-based telehealth visit with a physician licensed in your state. (3) If eligible, receive your medication directly to your doorstep from our trusted pharmacy partner.</p>
        </div>
      </div>
      <div class="faq__item">
        <button class="faq__trigger" onclick="toggleFaq(this)">
          <span class="faq__q">Do you accept insurance?</span>
          <span class="faq__icon">▾</span>
        </button>
        <div class="faq__content">
          <p class="faq__a">Malmo does not accept insurance at this time. You may be able to submit a claim with your insurance carrier on your own after you pay Malmo directly, but Malmo doesn't provide superbills or communicate with insurance carriers in any case.</p>
        </div>
      </div>
      <div class="faq__item">
        <button class="faq__trigger" onclick="toggleFaq(this)">
          <span class="faq__q">What pharmacies does Malmo work with?</span>
          <span class="faq__icon">▾</span>
        </button>
        <div class="faq__content">
          <p class="faq__a">Malmo works with state-licensed compounding pharmacies for treatment fulfillment. Compounding is regulated by state boards of pharmacy.</p>
        </div>
      </div>
      <div class="faq__item">
        <button class="faq__trigger" onclick="toggleFaq(this)">
          <span class="faq__q">What states do you ship to?</span>
          <span class="faq__icon">▾</span>
        </button>
        <div class="faq__content">
          <p class="faq__a">Malmo ships to all states nationwide.</p>
        </div>
      </div>
    </div>
    <p class="text-muted" style="margin-top:2rem;font-size:0.95rem;">Have more questions? <a href="/contact-us" style="text-decoration:underline;">Send us a message.</a></p>
  </div>
</section>

