    .hero__headline { font-size: clamp(1.9rem, 8vw, 2.6rem); }
    .hero__sub { font-size: 0.88rem; }
    .hero__tags { grid-template-columns: 1fr 1fr; gap: 0.4rem; }
    .hero__tag { font-size: 0.75rem; padding: 0.4rem 0.65rem; }
    .hero__tag svg { width: 0.85rem; height: 0.85rem; }
    .gallery__thumb { width: 2.5rem; height: 2.5rem; }
    .gallery__thumbs { gap: 0.5rem; bottom: 0.75rem; }
    .section__header { flex-direction: column; align-items: flex-start; gap: 0.75rem; }
    .section__title { font-size: clamp(1.9rem, 7vw, 2.8rem); }
    .benefits__grid { grid-template-columns: 1fr; }
    .benefit-card { min-height: 10rem; }
    .comp-cell { font-size: 0.75rem; padding: 0.6rem 0.5rem; }
    .comp-cell.header { font-size: 0.68rem; letter-spacing: 0; }
    .progesterone__grid { grid-template-columns: 1fr; gap: 2rem; }
    .progesterone__img { aspect-ratio: 4/3; }
    .treatments__grid { grid-template-columns: 1fr; }
    .treatment-card__title { font-size: 1.2rem; }
    .treatment-price { font-size: 1.3rem; }
    .how-grid { grid-template-columns: 1fr; gap: 2rem; }
    .how-card__img { aspect-ratio: 16/9; }
    .stat-grid { grid-template-columns: 1fr; gap: 2rem; }
    .stat-img { aspect-ratio: 4/3; }
    .reviews__grid { grid-template-columns: 1fr; }
    .why-grid { grid-template-columns: 1fr; }
    .why-card { padding: 1.5rem; }
    .faq__q { font-size: 1rem; font-weight: 600; }
    .faq__a { font-size: 0.88rem; }
    .cta-card__content { padding: 2rem 1.5rem; }
    .cta-card__title { font-size: 1.2rem; }
    .footer { padding: 3rem 0 1.5rem; }
    .footer__grid { grid-template-columns: 1fr; gap: 2rem; }
    .footer__brand { grid-column: auto; }
    .footer__email-form { flex-direction: column; }
    .footer__email-input { border-radius: 0.5rem; }
    .footer__email-btn { border-radius: 0.5rem; width: 100%; padding: 0.65rem; }
    .footer__bottom { flex-direction: column; align-items: flex-start; gap: 0.75rem; }
    .footer__legal-links { flex-direction: column; gap: 0.5rem; }
    .promo-banner__item { font-size: 0.78rem; }
  }

  /* ── SMALL MOBILE (≤400px) ── */
  @media (max-width: 400px) {
    .hero__tags { grid-template-columns: 1fr; }
    .hero__headline { font-size: 1.75rem; }
    .section__title { font-size: 1.75rem; }
    .comp-cell { font-size: 0.68rem; padding: 0.5rem 0.4rem; }
  }
</style>
