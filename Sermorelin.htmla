<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Malmo - Sermorelin</title>
  <link rel="icon" href="images/favicon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Red+Hat+Text:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root{--ink:#0D3B27;--ink2:#0D6C5C;--mid:#2F9B7C;--muted:#1A5C3A;--dark:#08281B;--cream:#F5F0E8;--panel:#EBF8F1;--line:#C5E6D5;--gold:#D0A85A;--gold-lt:#F0DDB8;--white:#fff}
    *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;font-family:'Red Hat Text',Arial,sans-serif;color:var(--ink);background:#fff;font-size:17px;line-height:1.7}a{color:inherit}img{max-width:100%;display:block}.container{width:min(1120px,calc(100% - 48px));margin:0 auto}h1,h2,h3{font-family:'Red Hat Text',sans-serif;letter-spacing:-.02em;color:var(--ink)}.btn{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:0 24px;border-radius:999px;background:var(--ink);color:#fff;text-decoration:none;font-weight:700;font-size:14px;border:1px solid var(--ink);white-space:nowrap;transition:transform .2s ease,box-shadow .2s ease}.btn:hover{transform:translateY(-2px);box-shadow:0 8px 20px rgba(13,59,39,.25)}.btn.secondary{background:#fff;color:var(--ink)}.pill{display:inline-flex;align-items:center;gap:7px;padding:6px 14px;border-radius:999px;background:#fff;box-shadow:0 1px 8px rgba(3,51,55,.08);font-size:13px}.pill:before{content:"";width:9px;height:9px;border-radius:50%;background:var(--gold)}.tiny-link{font-size:13px;text-decoration:underline;text-underline-offset:2px;color:var(--muted)}.header{position:absolute;top:0;left:0;width:100%;z-index:5;padding:28px 0}.nav{display:flex;align-items:center;justify-content:space-between}.logo{width:155px}

    /* scroll-reveal + hover image animation */
    .reveal{opacity:0;transform:translateY(28px);transition:opacity .7s ease,transform .7s ease}
    .reveal.in{opacity:1;transform:translateY(0)}
    .reveal-img{overflow:hidden;border-radius:14px}
    .img-zoom{transition:transform .6s ease}
    .img-zoom:hover{transform:scale(1.045)}
    .prod-img{transition:transform .4s ease}
    .product-card:hover .prod-img{transform:translateY(-6px) scale(1.04)}
    .float{animation:floaty 5s ease-in-out infinite}
    @keyframes floaty{0%,100%{transform:translateY(0)}50%{transform:translateY(-8px)}}
    @media(prefers-reduced-motion:reduce){.reveal,.img-zoom,.prod-img,.float{transition:none;animation:none;opacity:1;transform:none}}
    .perf-item.reveal:nth-child(2){transition-delay:.1s}.perf-item.reveal:nth-child(3){transition-delay:.2s}.perf-item.reveal:nth-child(4){transition-delay:.3s}
    .story.reveal:nth-child(2){transition-delay:.08s}.story.reveal:nth-child(3){transition-delay:.16s}.story.reveal:nth-child(4){transition-delay:.24s}.story.reveal:nth-child(5){transition-delay:.32s}.story.reveal:nth-child(6){transition-delay:.4s}
    .product-card.reveal:nth-child(2){transition-delay:.12s}

    .hero{position:relative;overflow:hidden;background:linear-gradient(180deg,var(--cream) 0%,var(--cream) 65%,var(--panel) 100%);padding:122px 0 72px}
    .hero-title{text-align:center;max-width:700px;margin:0 auto 48px;font-size:clamp(32px,4.2vw,50px);line-height:1.14;font-weight:800}
    .hero-title strong{font-weight:800;color:var(--ink2)}
    .product-row{display:grid;grid-template-columns:1fr 1fr;gap:32px;align-items:stretch}
    .product-card{display:flex;align-items:center;gap:24px;background:rgba(255,255,255,.85);border:1px solid var(--line);border-radius:14px;padding:32px 28px;position:relative;transition:box-shadow .3s ease,transform .3s ease}
    .product-card:hover{box-shadow:0 14px 34px rgba(13,59,39,.12);transform:translateY(-3px)}
    .prod-img{width:120px;flex:0 0 120px}
    .prod-body{min-width:0}
    .product-card h2{font-size:clamp(20px,2vw,26px);line-height:1.15;margin:0 0 6px;font-weight:700}
    .price{font-size:13px;font-weight:700;margin-bottom:14px;color:var(--muted)}
    .checklist{list-style:none;margin:0 0 16px;padding:0}
    .checklist li{font-size:13px;margin:6px 0;display:flex;gap:8px;align-items:flex-start}
    .checklist li:before{content:"";flex:0 0 9px;width:9px;height:9px;margin-top:4px;border-radius:50%;background:var(--gold)}

    .intro{padding:74px 0}.two-col{display:grid;grid-template-columns:1fr 1.16fr;gap:75px;align-items:center}.eyebrow{display:inline-flex;align-items:center;font-size:13px;font-weight:900;margin:0 0 14px;color:var(--gold);letter-spacing:.16em;text-transform:uppercase}.eyebrow:before{content:"";display:inline-block;width:8px;height:8px;border-radius:50%;background:var(--gold);margin-right:6px}.intro h2,.wellness h2,.learn h2{font-size:clamp(28px,3.2vw,44px);line-height:1.1;font-weight:700;margin:0 0 22px}.intro p,.wellness p,.learn p,.benefit-list p{font-size:18px;line-height:1.8;color:var(--muted);margin:0 0 26px}.intro img{border-radius:14px}
    .performance{min-height:535px;background:linear-gradient(90deg,rgba(4,34,39,.72) 0%,rgba(4,34,39,.45) 45%,rgba(4,34,39,.25) 100%),url('https://malmohealth.com/images/FeelandPerform.webp') center/cover no-repeat;color:#fff;padding:86px 0 46px;display:flex;align-items:flex-end;background-size:110%;transition:background-size .8s ease}.performance:hover{background-size:118%}.performance h2{color:#fff;font-size:clamp(26px,3vw,38px);line-height:1.15;font-weight:700;margin:0 0 28px;max-width:380px}.performance .btn.secondary{margin-bottom:11px}.perf-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:38px;margin-top:112px}.perf-item img{width:26px;margin-bottom:12px}.perf-item h3{font-size:17px;line-height:1.2;margin:0 0 6px;color:#fff;font-weight:700}.perf-item p{font-size:14px;line-height:1.5;margin:0;color:#fff}
    .wellness{padding:70px 0}.wellness .container{display:grid;grid-template-columns:1fr 1.2fr;gap:80px;align-items:center}.badges{display:grid;grid-template-columns:repeat(2,1fr);gap:15px}.badge{display:flex;align-items:center;gap:12px;background:var(--cream);border-radius:8px;padding:15px 18px;min-height:54px;font-size:14px;font-weight:700;transition:transform .3s ease,box-shadow .3s ease}.badge:hover{transform:translateY(-3px);box-shadow:0 10px 22px rgba(13,59,39,.1)}.badge img{width:30px;height:30px;object-fit:contain}
    .benefits{background:var(--cream);padding:74px 0}.benefit-box{border-radius:16px;background:var(--panel);padding:68px 94px;display:grid;grid-template-columns:.95fr 1.05fr;gap:80px;align-items:center}.vial-wrap{position:relative;display:flex;align-items:center;justify-content:center;min-height:300px}.dots{position:absolute;width:290px;height:290px;border-radius:50%;border:10px dotted rgba(13,59,39,.22);animation:spin 40s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}.vial-wrap img{width:210px;position:relative;z-index:2}.benefit-box h2{font-size:clamp(26px,3vw,36px);line-height:1.12;font-weight:700;margin:18px 0}.benefit-list{list-style:none;margin:0 0 24px;padding:0}.benefit-list li{font-size:15px;line-height:1.6;margin:12px 0;display:flex;gap:9px}.benefit-list li:before{content:"";width:8px;height:8px;flex:0 0 8px;border-radius:50%;background:var(--gold);margin-top:7px}
    .learn{background:var(--cream);padding:0 0 80px}.learn-grid{display:grid;grid-template-columns:.82fr 1.18fr;gap:70px}.learn-title{position:sticky;top:30px;align-self:start;padding-top:12px}.learn-title h2{font-size:clamp(32px,3.6vw,46px);font-weight:700;margin-bottom:20px;line-height:1.1}.learn-title strong{font-weight:800;color:var(--ink2)}.learn-title a{text-decoration:none;font-weight:700;font-size:16px;color:var(--ink)}.story{display:grid;grid-template-columns:260px 1fr;gap:22px;padding:0 0 22px;margin-bottom:22px;border-bottom:1px solid var(--line)}.story .reveal-img{width:260px;height:142px}.story .reveal-img img{width:260px;height:142px;object-fit:cover}.story h3{font-size:21px;line-height:1.2;margin:0 0 8px;font-weight:700}.story p{font-size:15px;line-height:1.6;margin:0;color:var(--muted)}
    .faq{background:var(--ink);padding:82px 0;color:#fff}.faq h2{text-align:center;font-size:clamp(26px,3vw,34px);font-weight:700;margin:0 0 44px;color:#fff}.accordion{display:grid;gap:18px}.faq-item{background:#fff;border-radius:10px;color:var(--ink);overflow:hidden}.faq-q{width:100%;background:none;border:0;text-align:left;padding:21px 34px;font-family:inherit;color:var(--ink);font-size:15px;font-weight:600;display:flex;justify-content:space-between;align-items:center;cursor:pointer}.faq-q span{font-size:20px}.faq-a{display:none;padding:0 34px 22px;color:var(--muted);font-size:14px;line-height:1.6}.faq-item.active .faq-a{display:block}.faq-item.active .faq-q span{transform:rotate(180deg)}
    .footer{background:var(--dark);color:#fff;padding:80px 0 40px}.footer-top{display:grid;grid-template-columns:1.2fr 1fr 1.25fr;gap:40px;align-items:start}.footer-logo{width:132px;margin-bottom:42px;background:#fff;border-radius:999px;padding:8px 14px}.footer-links{display:grid;gap:14px;font-size:13px}.footer-links a{text-decoration:none}.certs{display:grid;grid-template-columns:1fr 1fr;gap:14px;justify-items:end;align-items:center}.cert-chip{display:flex;align-items:center;justify-content:center;background:transparent;border-radius:0;padding:0;box-shadow:none}.cert-chip img{height:70px;width:auto;object-fit:contain;display:block}.social{text-align:center;margin:58px 0 78px;font-size:18px;letter-spacing:18px}.language{font-size:11px}.language select{display:block;margin-top:8px;background:var(--ink);color:#fff;border:1px solid var(--line);border-radius:2px;padding:8px 30px 8px 9px}.copyright{font-size:11px;margin-top:22px;color:var(--gold-lt)}

    @media(max-width:900px){.container{width:min(100% - 32px,720px)}.header{padding:22px 0}.logo{width:130px}.hero{padding-top:105px}.hero-title{font-size:25px}.product-row,.two-col,.wellness .container,.benefit-box,.learn-grid{grid-template-columns:1fr;gap:32px}.perf-grid{grid-template-columns:repeat(2,1fr);margin-top:60px}.performance{min-height:auto;padding:80px 0 50px}.badges{grid-template-columns:1fr}.benefit-box{padding:40px 24px}.story{grid-template-columns:130px 1fr}.story .reveal-img,.story .reveal-img img{width:130px;height:92px}.footer-top{grid-template-columns:1fr}.certs{justify-content:flex-start}.social{text-align:left}}
    @media(max-width:560px){body{font-size:15px}.nav .pill{display:none}.btn{font-size:13px;padding:0 18px}.hero-title{font-size:26px}.product-card{flex-direction:column;text-align:center;padding:28px 22px}.prod-img{width:100px;flex-basis:auto}.product-card h2{font-size:21px}.intro h2,.wellness h2{font-size:29px}.learn-title h2{font-size:32px}.perf-grid{grid-template-columns:1fr;gap:24px}.story{grid-template-columns:1fr}.story .reveal-img,.story .reveal-img img{width:100%;height:190px}.faq-q{padding:18px 18px}.faq-a{padding:0 18px 18px}.footer{padding:55px 0 35px}}
  </style>
</head>
<body>
  <header class="header">
    <div class="container nav">
      <img class="logo" src="https://malmohealth.com/images/malmologo.png" alt="Malmo">
      <div class="pill">Sermorelin</div>
      <a class="btn" href="#">Start Free Evaluation</a>
    </div>
  </header>

  <main>
    <section class="hero">
      <div class="container">
        <h1 class="hero-title">Better Sleep. Better Recovery. Better Body Composition. <strong>Malmo.</strong></h1>
        <div class="product-row">
          <div class="product-card reveal">
            <img class="prod-img" src="https://malmohealth.com/images/fdsfsdfwerwersdfs.webp" alt="Sermorelin Injections">
            <div class="prod-body">
              <h2>Sermorelin Injections</h2>
              <div class="price">As low as $135 per month</div>
              <ul class="checklist"><li>Supports Deeper, More Restorative Sleep</li><li>Encourages Natural GH Production</li><li>Helps Promote Fat Metabolism</li></ul>
              <a class="btn" href="#">Start Free Evaluation</a><br><a class="tiny-link" href="#safety">Important Safety Information</a>
            </div>
          </div>
          <div class="product-card reveal">
            <img class="prod-img" src="https://malmohealth.com/images/j1j1j1j1j1.webp" alt="Sermorelin Tablets">
            <div class="prod-body">
              <h2>Sermorelin Tablets</h2>
              <div class="price">As low as $135 per month</div>
              <ul class="checklist"><li>Needle Free</li><li>Fast Absorption</li><li>Improves Energy and Daytime Alertness</li></ul>
              <a class="btn" href="#">Start Free Evaluation</a><br><a class="tiny-link" href="#safety">Important Safety Information</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="intro">
      <div class="container two-col">
        <div><p class="eyebrow">Sermorelin</p><h2>Support your Natural Growth Hormone (GH) Production Safely and Effectively</h2><p>Sermorelin is a physician-supervised peptide that may improve sleep quality, metabolism, recovery, fat loss, and overall vitality, helping you feel and perform at your best.</p><a class="btn" href="#">Start Free Evaluation</a> <a class="btn secondary" href="#learn">Learn More</a></div>
        <div class="reveal reveal-img"><img class="img-zoom" src="https://malmohealth.com/images/AdobeStock_452382556.webp" alt="Woman sleeping peacefully"></div>
      </div>
    </section>

    <section class="performance">
      <div class="container">
        <h2>Feel and Perform at Your Best with Sermorelin</h2>
        <a class="btn secondary" href="#">Start Free Evaluation</a><br><a class="tiny-link" href="#safety" style="color:#fff">Important Safety Information</a>
        <div class="perf-grid">
          <div class="perf-item reveal"><img src="https://malmohealth.com/images/FeelMoreEnergized.svg"><h3>Feel More Energized</h3><p>Improves energy and daytime alertness, thanks to better sleep and hormonal regulation.</p></div>
          <div class="perf-item reveal"><img src="https://malmohealth.com/images/BalancedLifestyeSupport.svg"><h3>Balanced Lifestyle Support</h3><p>Fits into your holistic wellness program: nutrition, exercise, sleep, peptides.</p></div>
          <div class="perf-item reveal"><img src="https://malmohealth.com/images/CellularRenewal.svg"><h3>Cellular Renewal Support</h3><p>Supports healthy aging by aiding tissue repair and cellular turnover.</p></div>
          <div class="perf-item reveal"><img src="https://malmohealth.com/images/CognitiveWellness.svg"><h3>Cognitive Wellness</h3><p>May enhance cognitive function and overall mental well-being.</p></div>
        </div>
      </div>
    </section>

    <section class="wellness">
      <div class="container">
        <div><img class="logo" src="https://malmohealth.com/images/malmologo.png" alt="Malmo"><h2>Clinically Supervised Wellness Support</h2><p>Malmo makes it easy to access Sermorelin therapy through a fully online, clinician-guided experience. It's simple, convenient, and designed to fit your routine. No clinic visits. No hassle.</p><a class="btn" href="#">Start Free Evaluation</a></div>
        <div class="badges">
          <div class="badge"><img src="https://malmohealth.com/images/bring_your_own_ip_24dp_1F1F1F_FILL0_wght400_GRAD0_opsz24_1.png">100% Online Process</div>
          <div class="badge"><img src="https://malmohealth.com/images/stethoscope_24dp_5F6368_FILL0_wght400_GRAD0_opsz24.png">U.S. Licensed Providers</div>
          <div class="badge"><img src="https://malmohealth.com/images/syringe_24dp_5F6368_FILL0_wght400_GRAD0_opsz24.png">Trusted Metabolic Guidance</div>
          <div class="badge"><img src="https://malmohealth.com/images/syringe_24dp_5F6368_FILL0_wght400_GRAD0_opsz24.png">Made and Shipped in the U.S.A.</div>
          <div class="badge"><img src="https://malmohealth.com/images/block_24dp_5F6368_FILL0_wght400_GRAD0_opsz24.png">No Insurance or Hidden Fees</div>
          <div class="badge"><img src="https://malmohealth.com/images/box_24dp_5F6368_FILL0_wght400_GRAD0_opsz24.png">Private, Discreet Delivery</div>
        </div>
      </div>
    </section>

    <section class="benefits">
      <div class="container benefit-box">
        <div class="vial-wrap"><div class="dots"></div><img class="float" src="https://malmohealth.com/images/1a1a1a1a1bbbb.webp" alt="Sermorelin vial"></div>
        <div><p class="pill">Sermorelin</p><h2>Benefits of Sermorelin:</h2><ul class="benefit-list"><li>Supports deeper, more restorative sleep, which plays a major role in hormone balance, metabolism, and recovery.</li><li>Encourages natural GH production, which can decline significantly with age.</li><li>Helps promote fat metabolism, especially stubborn abdominal fat.</li><li>Supports muscle recovery and lean body mass when combined with healthy activity.</li></ul><a class="btn" href="#">Start Fast, Free Evaluation</a></div>
      </div>
    </section>

    <section id="learn" class="learn">
      <div class="container learn-grid">
        <div class="learn-title"><p class="eyebrow">Sermorelin</p><h2>Learn How <strong>Sermorelin</strong> Supports You</h2><a href="#">→ Get Started Today</a></div>
        <div>
          <article class="story reveal"><div class="reveal-img"><img class="img-zoom" src="https://malmohealth.com/images/AdobeStock_272480008.jpg"></div><div><h3>Supports Natural Hormone Signaling:</h3><p>Sermorelin works by stimulating your body's natural growth hormone signaling rather than replacing it. This gentle approach is designed to support balance over time by encouraging your body to do what it already knows how to do.</p></div></article>
          <article class="story reveal"><div class="reveal-img"><img class="img-zoom" src="https://malmohealth.com/images/AdobeStock_493809610.jpg"></div><div><h3>Promotes Restorative Sleep:</h3><p>Many people explore Sermorelin as part of a wellness routine that prioritizes quality sleep. By supporting natural hormone rhythms, Sermorelin may help create the conditions for deeper, more restorative rest.</p></div></article>
          <article class="story reveal"><div class="reveal-img"><img class="img-zoom" src="https://malmohealth.com/images/AdobeStock_297090552.jpg"></div><div><h3>Encourages Energy & Vitality:</h3><p>Sermorelin is often incorporated into wellness plans focused on maintaining steady energy levels throughout the day. Supporting healthy hormone signaling may help individuals feel more refreshed and resilient as part of an overall lifestyle approach.</p></div></article>
          <article class="story reveal"><div class="reveal-img"><img class="img-zoom" src="https://malmohealth.com/images/AdobeStock_195007431.jpg"></div><div><h3>Supports Healthy Aging:</h3><p>As we age, natural hormone production can shift over time. Sermorelin is commonly used to support healthy aging goals by helping maintain processes involved in tissue repair and cellular renewal.</p></div></article>
          <article class="story reveal"><div class="reveal-img"><img class="img-zoom" src="https://malmohealth.com/images/AdobeStock_526909574_1.jpg"></div><div><h3>Complements Body Composition Goals:</h3><p>Sermorelin is frequently paired with nutrition and movement routines aimed at supporting lean muscle and metabolic health. It fits naturally into a holistic approach focused on long-term wellness rather than quick fixes.</p></div></article>
          <article class="story reveal"><div class="reveal-img"><img class="img-zoom" src="https://malmohealth.com/images/AdobeStock_562962796.jpg"></div><div><h3>Fits Into a Holistic Wellness Routine:</h3><p>Sermorelin works best as part of a broader wellness plan that includes sleep, nutrition, exercise, and recovery. Its supportive role makes it a flexible option for those looking to take a more comprehensive, whole-body approach to health.</p></div></article>
        </div>
      </div>
    </section>

    <section class="faq">
      <div class="container">
        <h2>Frequently Asked Questions</h2>
        <div class="accordion">
          <div class="faq-item"><button class="faq-q">What is Sermorelin? <span>⌄</span></button><div class="faq-a">Sermorelin is a peptide therapy used under clinical supervision to support natural growth hormone production.</div></div>
          <div class="faq-item"><button class="faq-q">How does Sermorelin work? <span>⌄</span></button><div class="faq-a">It encourages the body's own signaling pathways related to growth hormone release.</div></div>
          <div class="faq-item"><button class="faq-q">Is Sermorelin the same as HGH? <span>⌄</span></button><div class="faq-a">No. Sermorelin supports natural production rather than directly replacing growth hormone.</div></div>
          <div class="faq-item"><button class="faq-q">What benefits can I expect? <span>⌄</span></button><div class="faq-a">Benefits may include support for sleep, recovery, energy, metabolism, and body composition goals.</div></div>
          <div class="faq-item"><button class="faq-q">Is Sermorelin safe? <span>⌄</span></button><div class="faq-a">Sermorelin should be used only with medical oversight to determine whether it is appropriate for you.</div></div>
          <div class="faq-item"><button class="faq-q">How is Sermorelin taken? <span>⌄</span></button><div class="faq-a">Treatment options can include injections or tablets depending on the plan recommended by a provider.</div></div>
          <div class="faq-item"><button class="faq-q">How long until I notice results? <span>⌄</span></button><div class="faq-a">Timing varies by individual, routine, dosage, sleep, nutrition, and overall health status.</div></div>
          <div class="faq-item"><button class="faq-q">Who is a good candidate? <span>⌄</span></button><div class="faq-a">A licensed provider can determine eligibility after reviewing your health history and goals.</div></div>
          <div class="faq-item"><button class="faq-q">Can I combine Sermorelin with other treatments? <span>⌄</span></button><div class="faq-a">Your clinician can advise what combinations are appropriate for your plan.</div></div>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="container">
      <div class="footer-top">
        <div><img class="footer-logo" src="https://malmohealth.com/images/malmologo.png" alt="Malmo"><div class="footer-links"><a href="#">FAQ</a><a href="#">About Us</a><a href="#">Contact</a><a href="#">Health Insights</a></div></div>
        <div class="footer-links"><a href="#">Terms of Use</a><a href="#">Privacy Policy</a><a href="#">HIPAA Notice</a><a href="#">CCPA Opt-Out</a><a href="#">Returns & Refunds</a></div>
        <div class="certs">
          <div class="cert-chip"><img src="https://malmohealth.com/images/Vector_5.svg" alt="HIPAA compliant"></div>
          <div class="cert-chip"><img src="https://malmohealth.com/images/Group_672.svg" alt="USA flag"></div>
        </div>
      </div>
      <div class="social">⊙ ◎</div>
      <div class="language">Language<select><option>English</option></select></div>
      <div class="copyright">© 2026, Malmo</div>
    </div>
  </footer>

  <script>
    document.querySelectorAll('.faq-q').forEach(function(btn){btn.addEventListener('click',function(){btn.closest('.faq-item').classList.toggle('active')})});

    var revealEls = document.querySelectorAll('.reveal');
    if('IntersectionObserver' in window){
      var io = new IntersectionObserver(function(entries){
        entries.forEach(function(entry){
          if(entry.isIntersecting){
            entry.target.classList.add('in');
            io.unobserve(entry.target);
          }
        });
      },{threshold:0.15,rootMargin:'0px 0px -40px 0px'});
      revealEls.forEach(function(el){io.observe(el)});
    } else {
      revealEls.forEach(function(el){el.classList.add('in')});
    }
  </script>
</body>
</html>
