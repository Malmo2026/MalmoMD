<!-- REVIEWS / VIDEO TESTIMONIALS -->
<div style="background:#ffffff;" id="reviews">
  <section style="position:relative;overflow:hidden;padding:80px 24px 40px;text-align:center;">

    <!-- Floating bottle images — hidden on mobile, visible on desktop -->
    <img src="images/sematall.png" alt="Semaglutide" class="bottle-float" style="position:absolute;left:-20px;bottom:0;width:clamp(140px,16vw,240px);opacity:0.95;transform:rotate(-12deg);pointer-events:none;z-index:1;">
    <img src="images/tirztall.png" alt="Tirzepatide" class="bottle-float" style="position:absolute;top:10px;right:12%;width:clamp(100px,12vw,190px);opacity:0.95;transform:rotate(18deg);pointer-events:none;z-index:1;">
    <img src="images/tirztall.png" alt="Tirzepatide" class="bottle-float" style="position:absolute;right:-10px;top:38%;width:clamp(110px,13vw,200px);opacity:0.95;transform:rotate(6deg);pointer-events:none;z-index:1;">
    <div style="max-width:740px;margin:0 auto 40px;">
      <h1 class="text-5xl sm:text-6xl font-bold" style="color:#0D3B27;font-family:'Cormorant Garamond',serif;">Real Customers. No shame.</h1>
      <h1 class="text-5xl sm:text-6xl font-bold" style="color:#0D3B27;font-family:'Cormorant Garamond',serif;">All <em>Confidence.</em></h1>
      <p class="text-lg sm:text-xl leading-relaxed my-8" style="color:#1A5C3A;">
        There's no shame in using medical weight loss to support your health when traditional methods aren't cutting it.
        Paired with a balanced diet and regular exercise, a weight loss treatment plan can help you overcome biological barriers, maintain healthy habits, and reach your goals.
      </p>
      <h2 class="text-2xl font-light" style="color:#0D3B27;font-family:'Cormorant Garamond',serif;">Watch what our customers have to say about losing weight with Malmo:</h2>
      <div style="margin:24px auto 0;width:0;height:0;border-left:16px solid transparent;border-right:16px solid transparent;border-top:20px solid #C9A96E;opacity:0.6;"></div>
    </div>

