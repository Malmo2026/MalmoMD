<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>GLP-1 Weight Loss Medications – Malmo</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">
<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<link href="images/favicon.png" rel="shortcut icon" type="image/x-icon">

<style>
/* =============================================
   COLOR OVERRIDES — everything else stays original
   ============================================= */
:root {
  --forest:     #0D3B27;
  --forest-md:  #1A5C3A;
  --forest-lt:  #2E7D52;
  --champagne:  #C9A96E;
  --gold-lt:    #F0DDB8;
  --mint-hero:  #EBF8F1;   /* ultra-light mint for hero box */
  --mint-pale:  #F4FAF7;   /* near-white section backgrounds */
  --mint-light: #DCF0E7;   /* slightly deeper for strips/borders */
  --mint-mid:   #C5E6D5;   /* for gradients */
}

/* ── GLOBAL ── */
body { font-family: 'DM Sans', sans-serif; }
h1, h2, h3 { font-family: 'Cormorant Garamond', Georgia, serif; }

@keyframes marquee { 0%{transform:translateX(0)} 100%{transform:translateX(-50%)} }

/* Hide floating bottles on mobile */
@media (max-width: 768px) {
  .bottle-float { display: none !important; }
}

/* Footer grid: 3 cols desktop, stacked on mobile */
@media (max-width: 768px) {
  .footer-grid-inner { grid-template-columns: 1fr !important; }
}
@media (max-width: 768px) {
  #weight { font-size: 2rem !important; width: 100% !important; border-radius: 10px !important; padding: 10px 14px !important; border: 2px solid #C5E6D5 !important; display: block !important; margin-top: 8px; }
}

/* ── PROMO BANNER ── */
/* original: black bg → forest green */
div[style*="background:#000"],
div[style*="background: #000"] {
  background: var(--forest) !important;
}
/* original gradient pill: yellow/pink/purple → mint green */
div[style*="background:linear-gradient(135deg,#fde68a"] {
  background: linear-gradient(135deg, #b8f0ce, #9de0b8, #7ccfa0) !important;
}
/* pill text was black → forest */
.ny-headline { color: var(--forest) !important; font-family: 'DM Sans', sans-serif !important; }
.ny-subline { color: var(--forest-md) !important; }
/* guarantee text */
div[style*="color:#fff"][style*="font-weight:300"] { color: rgba(255,255,255,0.75) !important; }

/* ── TICKER ── */
/* original: bg-blue-50 → light mint */
.bg-blue-50 { background-color: var(--mint-light) !important; }
/* ticker text */
.bg-blue-50 span, .bg-blue-50 div, .bg-blue-50 svg { color: var(--forest-md) !important; stroke: var(--forest-md) !important; }

/* ── HEADER ── */
/* nav links hover → forest */
header nav a:hover { color: var(--forest-lt) !important; }
/* CTA button: black → forest */
header a.bg-black,
header a[class*="bg-black"] {
  background-color: var(--forest) !important;
  border-radius: 999px;
}
header a.bg-black:hover { background-color: var(--forest-md) !important; }

/* ── HERO GRADIENT BOX ── */
/* original: from-yellow-200 via-pink-200 to-purple-300 → soft mint */
.bg-gradient-to-br.from-yellow-200 {
  background: linear-gradient(135deg, var(--mint-hero) 0%, #ddf5ea 40%, #e8f8f1 70%, var(--mint-hero) 100%) !important;
}
/* hero star rating */
.text-black.fill-current, svg.fill-current { fill: var(--champagne) !important; color: var(--champagne) !important; }
/* hero h1 */
section.bg-white h1.text-gray-900, section.bg-white h1 { color: var(--forest) !important; }
/* hero price */
section.bg-white strong.text-2xl, section.bg-white strong.text-3xl { color: var(--forest) !important; }
/* hero CTA buttons */
a.bg-black.text-white.rounded-full {
  background-color: var(--forest) !important;
}
a.bg-black.text-white.rounded-full:hover { background-color: var(--forest-md) !important; }
a.bg-white.border.border-gray-300.rounded-full:hover {
  background-color: var(--forest) !important;
  color: #fff !important;
  border-color: var(--forest) !important;
}

/* ── FEATURED IN / SOCIAL PROOF ── */
section.bg-white.text-center { background: #fff; }

/* ── BEFORE/AFTER SECTION ── */
/* original: bg-gray-100 → very light mint */
section.w-full.bg-gray-100 { background-color: var(--mint-pale) !important; }
/* calculator card bg */
.md\:w-1\/2.bg-white.rounded-3xl { border-color: var(--mint-light) !important; }
/* tag gradient → mint */
.tag.bg-gradient-to-br { background: linear-gradient(135deg, var(--mint-light), var(--mint-mid)) !important; color: var(--forest) !important; }
.tag .value { color: var(--forest) !important; }
/* slider handle */
.slider-handle { background: var(--forest) !important; }
.slider-handle::before, .slider-handle::after { background: var(--forest) !important; }
/* before/after labels */
.before-after-label { background: rgba(13,59,39,0.85) !important; color: #d8f3dc !important; }
/* trust bar border */
.border-\[\#E2E2E1\] { border-color: var(--mint-light) !important; }
/* features strip */
.features-bar, [class*="border-E2E2E1"] { border-color: var(--mint-mid) !important; }
/* CTA buttons in section */
section a.bg-black, div a.bg-black { background-color: var(--forest) !important; }
section a.bg-black:hover { background-color: var(--forest-md) !important; }

/* ── REVIEWS SECTION ── */
.bg-gray-100 { background-color: var(--mint-pale) !important; }
/* review section headlines */
#reviews h1.text-gray-800, #reviews h1 { color: var(--forest) !important; }
#reviews p.text-gray-600 { color: var(--forest-md) !important; }
/* vimeo cards */
.vimeo-card { border-radius: 16px !important; overflow: hidden; }

/* ── HOW IT WORKS ── */
/* hero-bg2 background */
.hero-bg2 { background: var(--mint-pale) !important; }
/* white rounded box stays white */
.hero-bg2 .bg-white { background: #fff !important; }
/* HIW headline */
.hero-bg2 h2.text-gray-900 { color: var(--forest) !important; }
.hero-bg2 p.text-gray-700 { color: var(--forest-md) !important; }
/* step time labels → champagne */
.hero-bg2 details summary { color: var(--forest) !important; }
/* testimonial cards */
.swiper-slide.bg-gray-50 { background-color: var(--mint-pale) !important; }
.swiper-slide h3.text-gray-800 { color: var(--forest) !important; }
.swiper-slide p.text-yellow-400, .swiper-slide div.text-yellow-400 { color: var(--champagne) !important; }

/* ── PRODUCTS SECTION ── */
section.w-full.bg-gray-100.py-16 { background: var(--mint-pale) !important; }
/* product card bg */
.rounded-3xl.bg-white { background: #fff !important; }
/* product badge → mint gradient */
span.bg-gradient-to-br.from-yellow-200 {
  background: linear-gradient(135deg, var(--mint-light), var(--mint-mid)) !important;
  color: var(--forest) !important;
}
/* product headlines */
section.w-full.bg-gray-100 h2 { color: var(--forest) !important; }

/* ── FAQ ── */
#faqs h2 { color: var(--forest) !important; }
#faqs p.text-gray-600 { color: var(--forest-md) !important; }
.border-gray-200 { border-color: var(--mint-mid) !important; }
.border-gray-200 button { color: var(--forest) !important; }
.border-gray-200 .text-gray-700, .border-gray-200 .text-gray-500 { color: var(--forest-md) !important; }

/* ── FOOTER CTA ── */
/* original: from-yellow-100 via-pink-100 to-purple-100 → soft mint gradient */
footer.bg-gradient-to-br {
  background: linear-gradient(135deg, var(--mint-hero) 0%, #ddf5ea 40%, var(--mint-mid) 100%) !important;
}
footer h2.text-gray-900 { color: var(--forest) !important; }
footer p.text-gray-600 { color: var(--forest-md) !important; }
footer a.bg-black { background-color: var(--forest) !important; }
footer a.bg-black:hover { background-color: var(--forest-md) !important; }
/* footer links text */
footer .text-gray-700 { color: var(--forest-md) !important; }
footer .text-gray-500 { color: rgba(13,59,39,0.55) !important; }
footer h3.text-gray-900 { color: var(--forest) !important; }
footer .text-xs.text-gray-500 { color: rgba(13,59,39,0.5) !important; }
/* footer bottom bar */
footer.bg-gray-800 { background-color: var(--forest) !important; }
footer.bg-gray-800 .text-gray-400 { color: rgba(255,255,255,0.5) !important; }

/* ── SWIPER OVERRIDES ── */
.swiper-button-next, .swiper-button-prev { color: var(--forest) !important; }
.swiper-pagination-bullet-active { background: var(--champagne) !important; }

/* ── MISC ── */
/* any remaining blue hovers → forest */
.hover\:text-blue-500:hover { color: var(--forest-lt) !important; }
.hover\:bg-blue-500:hover { background-color: var(--forest) !important; }
/* check icons */
.bi-check-circle, .bi-ban { color: var(--champagne) !important; }
/* gray text cleanup */
.text-gray-900 { color: var(--forest) !important; }

/* ── STEP TIME LABELS (HIW) ── */
p[style*="color:#d9b596"],
p[style*="color:#b89e73"],
p[style*="color:#c9a9c9"],
p[style*="color:#e7a1d9"],
p[style*="color:#c87ad4"] {
  color: var(--champagne) !important;
}

/* ── MOBILE HEADER HAMBURGER ── */
.md\:hidden button svg { stroke: var(--forest) !important; }
</style>
</head>
<body class="bg-white text-gray-900">

<!-- HARD-CODED PROMO BANNER -->
<div style="width:100%; background:#0D3B27; overflow:hidden;">
  <div style="max-width:800px;margin:0 auto;padding:14px 10px;display:flex;align-items:center;justify-content:center;gap:16px;position:relative;">
    <div style="text-align:center;line-height:1.15;position:relative;z-index:2;">
      <div style="display:inline-block;padding:8px 18px;border-radius:999px;background:linear-gradient(135deg,#b8f0ce,#9de0b8,#7ccfa0);">
        <div style="font-size:20px;font-weight:700;color:#0D3B27;font-family:'DM Sans',sans-serif;">SPRING Discount Applied!</div>
        <div style="font-size:12px;font-weight:500;color:#1A5C3A;margin-top:2px;font-family:'DM Sans',sans-serif;">Just $149 + Fast, Free Shipping</div>
      </div>
      <div style="margin-top:6px;padding:6px 18px;">
        <div style="font-size:18px;font-weight:300;color:rgba(255,255,255,0.8);font-family:'DM Sans',sans-serif;">+ Fully backed by our weight loss guarantee!</div>
      </div>
    </div>
  </div>
</div>

<!-- TICKER -->
<div style="background:#f0f8f4;overflow:hidden;border-bottom:1px solid #e0ede8;">
  <div style="display:flex;white-space:nowrap;animation:marquee 40s linear infinite;">
    <div style="display:flex;gap:0;">
      <span style="display:inline-flex;align-items:center;gap:8px;font-size:13px;font-weight:600;color:#3a6b50;padding:9px 28px;">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="#3a6b50"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
        Accessible &amp; Affordable
      </span>
