          <div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:40px;height:40px;border-radius:50%;background:#0D3B27;box-shadow:0 2px 12px rgba(13,59,39,0.4);display:flex;align-items:center;justify-content:center;">
