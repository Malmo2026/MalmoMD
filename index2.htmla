        <span style="position:absolute;z-index:10;background:rgba(13,59,39,0.78);color:#e8f5ee;font-size:12px;font-weight:600;padding:4px 12px;border-radius:999px;top:12px;left:12px;">June 2025</span>
        <span style="position:absolute;z-index:10;background:rgba(13,59,39,0.78);color:#e8f5ee;font-size:12px;font-weight:600;padding:4px 12px;border-radius:999px;top:12px;right:12px;">August 2025</span>
        <img src="index_files/slider-after.png" alt="Before" style="width:100%;display:block;">
        <img src="index_files/slider-before.png" alt="After" id="baAfterImg" style="position:absolute;top:0;left:0;width:100%;height:100%;object-fit:cover;clip-path:inset(0 50% 0 0);">
