        Personalized Treatment Plans
      </span>
      <span style="display:inline-flex;align-items:center;gap:8px;font-size:13px;font-weight:600;color:#3a6b50;padding:9px 28px;">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="#3a6b50"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
        Certified Medical Professionals
      </span>
      <span style="display:inline-flex;align-items:center;gap:8px;font-size:13px;font-weight:600;color:#3a6b50;padding:9px 28px;">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="#3a6b50"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
        Safe &amp; Effective Medications
      </span>
      <span style="display:inline-flex;align-items:center;gap:8px;font-size:13px;font-weight:600;color:#3a6b50;padding:9px 28px;">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="#3a6b50"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
        100k+ Happy Customers
      </span>
      <!-- duplicate set -->
      <span style="display:inline-flex;align-items:center;gap:8px;font-size:13px;font-weight:600;color:#3a6b50;padding:9px 28px;">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="#3a6b50"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
        Accessible &amp; Affordable
      </span>
      <span style="display:inline-flex;align-items:center;gap:8px;font-size:13px;font-weight:600;color:#3a6b50;padding:9px 28px;">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="#3a6b50"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
        Personalized Treatment Plans
      </span>
      <span style="display:inline-flex;align-items:center;gap:8px;font-size:13px;font-weight:600;color:#3a6b50;padding:9px 28px;">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="#3a6b50"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
        Certified Medical Professionals
      </span>
      <span style="display:inline-flex;align-items:center;gap:8px;font-size:13px;font-weight:600;color:#3a6b50;padding:9px 28px;">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="#3a6b50"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
        Safe &amp; Effective Medications
      </span>
      <span style="display:inline-flex;align-items:center;gap:8px;font-size:13px;font-weight:600;color:#3a6b50;padding:9px 28px;">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="#3a6b50"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
        100k+ Successful Patients
      </span>
    </div>
  </div>
</div>

<!-- HEADER -->
<header class="bg-white shadow-md">
  <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
    <div class="text-xl font-bold text-gray-900">
      <a href="#"><img src="images/Malmologo.png" style="max-width:150px;"></a>
    </div>
    <nav class="hidden md:flex space-x-8 font-medium" style="color:#38312c;">
      <a href="#howitworks" style="color:#38312c;" class="hover:text-blue-500">How it works</a>
      <a href="#reviews" style="color:#38312c;" class="hover:text-blue-500">Reviews</a>
      <a href="#faqs" style="color:#38312c;" class="hover:text-blue-500">FAQ's</a>
      <a href="#pricing" style="color:#38312c;" class="hover:text-blue-500">Pricing</a>
    </nav>
    <div class="hidden md:block">
      <a href="#" style="background:linear-gradient(135deg,#0D3B27,#1A5C3A);color:#fff;" class="px-5 py-2 rounded-full font-semibold transition hover:opacity-90">Start Your Journey</a>
    </div>
    <div class="md:hidden">
      <button type="button" style="color:#0D3B27;" onclick="document.getElementById('mobileNav').classList.toggle('hidden')">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>
    </div>
  </div>
  <!-- mobile nav -->
  <div id="mobileNav" class="hidden md:hidden flex-col px-6 pb-4 space-y-3" style="background:#fff;border-top:1px solid #f0f0f0;">
    <a href="#howitworks" style="color:#0D3B27;display:block;padding:10px 0;font-weight:500;border-bottom:1px solid #f0f0f0;" onclick="document.getElementById('mobileNav').classList.add('hidden')">How it works</a>
    <a href="#reviews" style="color:#0D3B27;display:block;padding:10px 0;font-weight:500;border-bottom:1px solid #f0f0f0;" onclick="document.getElementById('mobileNav').classList.add('hidden')">Reviews</a>
    <a href="#faqs" style="color:#0D3B27;display:block;padding:10px 0;font-weight:500;border-bottom:1px solid #f0f0f0;" onclick="document.getElementById('mobileNav').classList.add('hidden')">FAQ's</a>
    <a href="#pricing" style="color:#0D3B27;display:block;padding:10px 0;font-weight:500;border-bottom:1px solid #f0f0f0;" onclick="document.getElementById('mobileNav').classList.add('hidden')">Pricing</a>
    <a href="#" style="background:linear-gradient(135deg,#0D3B27,#1A5C3A);color:#fff;display:block;text-align:center;padding:12px;border-radius:999px;font-weight:600;margin-top:8px;box-shadow:0 3px 12px rgba(13,59,39,0.2);">Start Your Journey</a>
  </div>
</header>

<!-- HERO -->
<section class="bg-white px-4">
  <div style="border-radius:50px;overflow:hidden;width:100%;background:linear-gradient(145deg,#eaf6f1 0%,#f4fbf8 50%,#eaf6f1 100%);padding:40px 28px 64px;" class="md:py-16">
    <div class="flex flex-col md:flex-row items-center justify-between max-w-7xl mx-auto">

      <!-- Left text -->
      <div class="w-full lg:w-2/3 mb-0 md:mb-0">
        <div class="flex items-center space-x-1 mb-2" style="color:#C9A96E;">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.286 3.943a1 1 0 00.95.69h4.15c.969 0 1.371 1.24.588 1.81l-3.36 2.444a1 1 0 00-.364 1.118l1.286 3.943c.3.921-.755 1.688-1.54 1.118l-3.36-2.444a1 1 0 00-1.176 0l-3.36 2.444c-.784.57-1.838-.197-1.54-1.118l1.287-3.943a1 1 0 00-.364-1.118L2.075 9.37c-.783-.57-.38-1.81.588-1.81h4.15a1 1 0 00.95-.69l1.286-3.943z"/></svg>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.286 3.943a1 1 0 00.95.69h4.15c.969 0 1.371 1.24.588 1.81l-3.36 2.444a1 1 0 00-.364 1.118l1.286 3.943c.3.921-.755 1.688-1.54 1.118l-3.36-2.444a1 1 0 00-1.176 0l-3.36 2.444c-.784.57-1.838-.197-1.54-1.118l1.287-3.943a1 1 0 00-.364-1.118L2.075 9.37c-.783-.57-.38-1.81.588-1.81h4.15a1 1 0 00.95-.69l1.286-3.943z"/></svg>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.286 3.943a1 1 0 00.95.69h4.15c.969 0 1.371 1.24.588 1.81l-3.36 2.444a1 1 0 00-.364 1.118l1.286 3.943c.3.921-.755 1.688-1.54 1.118l-3.36-2.444a1 1 0 00-1.176 0l-3.36 2.444c-.784.57-1.838-.197-1.54-1.118l1.287-3.943a1 1 0 00-.364-1.118L2.075 9.37c-.783-.57-.38-1.81.588-1.81h4.15a1 1 0 00.95-.69l1.286-3.943z"/></svg>
