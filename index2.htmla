    </div>

    <!-- Calculator -->
    <div class="md:w-1/2 w-full flex items-center justify-center p-6 rounded-3xl bg-white overflow-hidden" style="border:1px solid #e2ece7;">
      <div class="text-center md:text-left max-w-md">
