<script>
function toggleFaq(btn) {
  const item = btn.parentElement;
  const content = btn.nextElementSibling;
  const isOpen = !content.classList.contains('hidden');
  document.querySelectorAll('.faq-item .hidden ~ *').forEach(() => {});
  document.querySelectorAll('.faq-item > div:not(.hidden)').forEach(d => d.classList.add('hidden'));
  if (!isOpen) content.classList.remove('hidden');
}

const wEl   = document.getElementById('weight');
const wsEl  = document.getElementById('weightSlider');
const lbsEl = document.getElementById('lbs');
function updateCalc(v) { if(lbsEl) lbsEl.textContent = Math.round(Number(v) * 0.20); }
if (wEl) {
  wEl.addEventListener('input', () => { wsEl.value = wEl.value; updateCalc(wEl.value); });
  wsEl.addEventListener('input', () => { wEl.value = wsEl.value; updateCalc(wsEl.value); });
}

// Before/After slider
const baContainer = document.getElementById('customImageSlider');
const baAfterImg  = document.getElementById('baAfterImg');
const baHandle    = document.getElementById('baHandle');
let dragging = false;
function moveBA(clientX) {
  if (!baContainer) return;
  const r = baContainer.getBoundingClientRect();
  const pct = Math.max(0, Math.min(100, ((clientX - r.left) / r.width) * 100));
  baHandle.style.left = pct + '%';
  baAfterImg.style.clipPath = 'inset(0 ' + (100 - pct) + '% 0 0)';
}
if (baHandle) {
  baHandle.addEventListener('mousedown', e => { dragging = true; e.preventDefault(); });
  document.addEventListener('mouseup', () => dragging = false);
  document.addEventListener('mousemove', e => { if (dragging) moveBA(e.clientX); });
  baHandle.addEventListener('touchstart', e => { dragging = true; e.preventDefault(); });
  document.addEventListener('touchend', () => dragging = false);
  if (baContainer) baContainer.addEventListener('touchmove', e => { if (dragging) moveBA(e.touches[0].clientX); });
}

// Vimeo carousel
new Swiper('.vimeo-carousel', {
  slidesPerView: 1.15, spaceBetween: 16, centeredSlides: true, loop: false,
  pagination: { el: '.vimeo-carousel .swiper-pagination', clickable: true, dynamicBullets: true },
  navigation: { nextEl: '.vimeo-carousel .swiper-button-next', prevEl: '.vimeo-carousel .swiper-button-prev' },
  breakpoints: {
    640:  { slidesPerView: 1.4, spaceBetween: 18 },
    768:  { slidesPerView: 2.3, spaceBetween: 20 },
    1024: { slidesPerView: 3,   spaceBetween: 24, centeredSlides: false },
    1280: { slidesPerView: 4,   spaceBetween: 24, centeredSlides: false }
  }
});

// Testimonials
new Swiper('.testimonials-carousel', {
  slidesPerView: 1.2, spaceBetween: 16, loop: true,
  autoplay: { delay: 4500, disableOnInteraction: false },
  navigation: { nextEl: '.testimonials-carousel .swiper-button-next', prevEl: '.testimonials-carousel .swiper-button-prev' },
  breakpoints: { 640: { slidesPerView: 2 }, 1024: { slidesPerView: 4, spaceBetween: 20 } }
});

// Features slider mobile — only 4 slides so no loop, use rewind
new Swiper('.features-slider', {
  slidesPerView: 1, spaceBetween: 0, loop: false, rewind: true,
  autoplay: { delay: 3000, disableOnInteraction: false }, speed: 600
});
</script>
</body>
